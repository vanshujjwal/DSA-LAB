#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *next;
};

struct Node* insertBeginning(struct Node *last, int data) {
    struct Node *newNode = (struct Node*)malloc(sizeof(struct Node));

    newNode->data = data;

    
    if (last == NULL) {
        newNode->next = newNode;
        last = newNode;
    }
    else {
        
        newNode->next = last->next;

        
        last->next = newNode;
    }

    return last;
}

void display(struct Node *last) {
    if (last == NULL) {
        printf("List is empty\n");
        return;
    }

    struct Node *temp = last->next;  

    do {
        printf("%d ", temp->data);
        temp = temp->next;
    } while (temp != last->next);

    printf("\n");
}

int main() {
    struct Node *last = NULL;

    last = insertBeginning(last, 30);
    last = insertBeginning(last, 20);
    last = insertBeginning(last, 10);

    printf("Circular Linked List: ");
    display(last);

    return 0;
}
